 "deployment_rules": [
  {
   "id": "DR1",
   "rule": "channel binding on at both ends",
   "why": "a proof without cb is rejected by a verifier that expects cb, and a verifier without an expected cb rejects a bound proof (fail closed)",
   "harness": [
    "F2",
    "F3"
   ]
  },
  {
   "id": "DR2",
   "rule": "trust a forwarded cb header only when the gateway overwrites it",
   "why": "with app.psu.nipok.trust-forwarded-cb-header=true and no overwrite, a client chooses cb and a relay passes",
   "harness": [
    "F4",
    "F5"
   ]
  },
  {
   "id": "DR3",
   "rule": "a distinct id_V per verifier (the issuer identifier of its authorization server)",
   "why": "with cb off and a shared id_V such as the default 'bank', a proof relayed between two banks is accepted; distinct id_V values stop it even with cb off",
   "harness": [
    "G3",
    "G4"
   ]
  },
  {
   "id": "DR4",
   "rule": "id_P exchanged byte for byte (NFC recommended for non-ASCII names)",
   "why": "the verifier hashes the submitted bytes; NFC and NFD forms of one name give different challenges",
   "harness": [
    "C11",
    "C12"
   ]
  },
  {
   "id": "DR5",
   "rule": "keys checked at registration (canonical, [8]X != O, [l]X == O) and one key per PSU and method",
   "why": "every verifier, whatever its library, then accepts the same set of keys; a second registration returns 409",
   "harness": [
    "H5",
    "H6",
    "R4",
    "R5",
    "R8"
   ]
  }
 ],
