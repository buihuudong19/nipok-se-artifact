# PostgreSQL credentials
POSTGRES_USERNAME=user
POSTGRES_PASSWORD=pwd

# MongoDB root (only for initialization)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=rootpassword

# MongoDB databases for services
MONGO_CUSTOMER_DATABASE=customer-db
MONGO_PRODUCT_DATABASE=product-db
# PostgreSQL database for account service
POSTGRES_ACCOUNT_DATABASE=account-db


# Customer service credentials
MONGO_CUSTOMER_USERNAME=customer_user
MONGO_CUSTOMER_PASSWORD=customer_password

# Product service credentials
MONGO_PRODUCT_USERNAME=product_user
MONGO_PRODUCT_PASSWORD=product_password

# SQL Server credentials (transaction-service)
MSSQL_SA_PASSWORD=Sqlserver@123
MSSQL_TRANSACTION_DATABASE=transaction-db

# MySQL credentials (payment-service)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_PAYMENT_DATABASE=payment-db
MYSQL_PAYMENT_USERNAME=payment_user
MYSQL_PAYMENT_PASSWORD=payment_password