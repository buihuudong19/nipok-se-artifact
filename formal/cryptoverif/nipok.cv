(* ============================================================================ *)
(*  nipok.cv — CryptoVerif: xác thực NIPoK + channel-binding trong MÔ HÌNH       *)
(*             TÍNH TOÁN (game-based). Chứng minh INJECTIVE-AGREEMENT + CHẶN      *)
(*             advantage, GIẢ ĐỊNH NIPoK là chữ ký UF-CMA trên context.          *)
(*                                                                               *)
(*  Ý tưởng mô hình: NIPoK proof ≈ chữ ký UF-CMA của PSU trên                     *)
(*       context = (X, nonce_Bank, channel-binding, verifierId).                 *)
(*    - "secret key" = scalar x ;  "verify key" = X = xB.                         *)
(*    - Bank verify bằng cb = certS (cert THẬT của mình); PSU ký bằng cb nó THẤY. *)
(*  ⟹ Relay (cb lệch) ⟹ phải GIẢ MẠO chữ ký trên (X,n,certS) ⟹ phá UF-CMA.        *)
(*                                                                               *)
(*  KẾT QUẢ: Adv_auth ≤ N · Adv_UF-CMA(PSU-key) + thống kê nonce-collision.       *)
(*  (Tầng PRIMITIVE — UF-CMA của Schnorr-FS từ DL — để EasyCrypt; xem SchnorrFS.ec) *)
(*  CHẠY: cryptoverif nipok.cv                                                    *)
(*                                                                               *)
(*  G11 — KEY CUSTODY: khóa PSU (skP) là giá trị bí mật do principal Wallet giữ,   *)
(*    sinh trong KeyGen, KHÔNG ra kênh ⟹ bound/secrecy độc lập với BACKEND lưu trữ  *)
(*    (sim SEALED/off-heap, K8s-Secret, Vault, TEE). Mô hình computational GIẢ ĐỊNH *)
(*    custody tin cậy; SEALED+Secret+off-heap là phần HIỆN THỰC HÓA giả định đó     *)
(*    (at-rest/host-dump nằm ngoài phạm vi PPT-trên-kênh).                          *)
(* ============================================================================ *)

proof {
  crypto uf_cma(sign);   (* áp giả định UF-CMA cho khóa PSU *)
  success
}

param N, N2.

type nonce  [large, fixed].
type cb_t   [large, fixed].
type keyseed [large, fixed].
type pkey   [bounded].
type skey   [bounded].
type signinput [bounded].
type signature [bounded].

(* Chữ ký UF-CMA (det.) mô hình hoá NIPoK; khóa = scalar/X. (Macro lib: check, Pkeycoll) *)
proba Psign.       (* advantage UF-CMA *)
proba Pkeycoll.    (* xác suất key-collision *)
expand UF_CMA_det_signature(keyseed, pkey, skey, signinput, signature,
                            skgen, pkgen, sign, check, Psign, Pkeycoll).

(* Đóng gói context (X, nonce, cb, verifierId) thành 1 thông điệp ký *)
type host [bounded].
fun ctx(pkey, nonce, cb_t, host): signinput [data].

const bankId: host.
const certS:  cb_t.        (* channel-binding = hash(cert gateway THẬT) — Bank dùng *)

(* Sự kiện cho injective-agreement *)
event psu_proves(pkey, nonce, cb_t).
event bank_accepts(pkey, nonce, cb_t).

(* ★ Mục tiêu: Bank accept (X,n,cb) ⟹ ĐÚNG một PSU đã prove (X,n,cb) — chống relay *)
query X:pkey, n:nonce, cb:cb_t;
  inj-event(bank_accepts(X,n,cb)) ==> inj-event(psu_proves(X,n,cb)).

(* Kênh *)
channel cKey, cP1, cP2, cB1, cB2.

(* ── PSU: nhận (n, cb-nó-thấy), ký context, gửi proof ─────────────────────── *)
let processPSU(skP: skey, pkP: pkey) =
  ! N
  in(cP1, (n: nonce, seenCb: cb_t));
  event psu_proves(pkP, n, seenCb);
  out(cP2, sign(ctx(pkP, n, seenCb, bankId), skP)).

(* ── Bank: phát nonce tươi, verify proof với KHÓA ĐÃ ĐĂNG KÝ pkP + cb=certS (THẬT) ─ *)
(*    Bank tra khóa của Alice (pkP) — KHÔNG nhận X tùy ý (attacker tự đăng ký khóa khác *)
(*    là hợp lệ, không phải lỗ hổng) ⟹ chỉ chứng nhận xác thực CHO ĐÚNG Alice.          *)
let processBank(pkP: pkey) =
  ! N2
  in(cB1, ());
  new n: nonce;
  out(cB1, n);
  in(cB2, s: signature);
  if check(ctx(pkP, n, certS, bankId), pkP, s) then
    event bank_accepts(pkP, n, certS).

(* ── Hệ thống ─────────────────────────────────────────────────────────────── *)
process
  in(cKey, ());
  new ks: keyseed;
  let skP = skgen(ks) in
  let pkP = pkgen(ks) in
  out(cKey, pkP);          (* X = pk public *)
  ( processPSU(skP, pkP) | processBank(pkP) )

(* Diễn giải kết quả: CryptoVerif xuất "RESULT ... is true" + một probability bound
   tham số hoá theo Psign (advantage UF-CMA). Đó chính là CHẶN advantage của thuộc
   tính xác thực — phần "composition + bound" của khung kiểm chứng. *)
