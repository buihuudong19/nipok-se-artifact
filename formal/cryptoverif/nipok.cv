(* ============================================================================ *)
(*  nipok.cv - CryptoVerif: NIPoK authentication + channel binding in the         *)
(*             COMPUTATIONAL (game-based) MODEL. Proves INJECTIVE AGREEMENT with a *)
(*             BOUNDED advantage, ASSUMING NIPoK is a UF-CMA signature on the context. *)
(*                                                                               *)
(*  Modelling idea: NIPoK proof ≈ UF-CMA signature of the PSU on                   *)
(*       context = (X, nonce_Bank, channel binding, verifierId).                  *)
(*    - "secret key" = scalar x ;  "verification key" = X = xB.                   *)
(*    - The bank verifies with cb = certS (its REAL certificate); the PSU signs with the cb it SEES. *)
(*  => Relay (different cb) => a signature on (X,n,certS) must be FORGED => breaks UF-CMA. *)
(*                                                                               *)
(*  RESULT: Adv_auth ≤ N · Adv_UF-CMA(PSU key) + nonce-collision statistics.       *)
(*  (PRIMITIVE layer - UF-CMA of Schnorr-FS from DL - in EasyCrypt; see SchnorrFS.ec) *)
(*  RUN: cryptoverif nipok.cv                                                     *)
(*                                                                               *)
(*  KEY CUSTODY: the PSU key (skP) is a secret value held by the wallet principal, *)
(*    generated in KeyGen and NEVER sent on a channel => the bound/secrecy does not depend on the storage BACKEND *)
(*    (simulator SEALED/off-heap, Kubernetes Secret, Vault, TEE). The computational model ASSUMES *)
(*    trusted custody; SEALED + Secret + off-heap IMPLEMENT that assumption       *)
(*    (at-rest/host dumps are outside the PPT-on-the-channel scope).              *)
(* ============================================================================ *)

proof {
  crypto uf_cma(sign);   (* applies the UF-CMA assumption to the PSU key *)
  success
}

param N, N2.

type nonce  [large, fixed].
type cb_t   [large, fixed].
type keyseed [large, fixed].
type pkey   [bounded].
type skey   [bounded].
type signinput [bounded].
type signature [bounded].

(* UF-CMA (deterministic) signature modelling NIPoK; key = scalar/X. (Library macro: check, Pkeycoll) *)
proba Psign.       (* UF-CMA advantage *)
proba Pkeycoll.    (* key-collision probability *)
expand UF_CMA_det_signature(keyseed, pkey, skey, signinput, signature,
                            skgen, pkgen, sign, check, Psign, Pkeycoll).

(* The context (X, nonce, cb, verifierId) is packed into one signed message *)
type host [bounded].
fun ctx(pkey, nonce, cb_t, host): signinput [data].

const bankId: host.
const certS:  cb_t.        (* channel binding = hash(REAL gateway certificate), used by the bank *)

(* Events for the injective agreement *)
event psu_proves(pkey, nonce, cb_t).
event bank_accepts(pkey, nonce, cb_t).

(* Goal: the bank accepts (X,n,cb) => EXACTLY one PSU proved (X,n,cb) - against relay *)
query X:pkey, n:nonce, cb:cb_t;
  inj-event(bank_accepts(X,n,cb)) ==> inj-event(psu_proves(X,n,cb)).

(* Channels *)
channel cKey, cP1, cP2, cB1, cB2.

(* -- PSU: receives (n, the cb it sees), signs the context, sends the proof ------------- *)
let processPSU(skP: skey, pkP: pkey) =
  ! N
  in(cP1, (n: nonce, seenCb: cb_t));
  event psu_proves(pkP, n, seenCb);
  out(cP2, sign(ctx(pkP, n, seenCb, bankId), skP)).

(* -- Bank: issues a fresh nonce, verifies the proof with the REGISTERED key pkP + cb = certS (REAL) - *)
(*    The bank looks up the key of Alice (pkP) and does NOT accept an arbitrary X (an attacker registering *)
(*    its own key is legitimate, not a flaw) => authentication is certified FOR Alice only.          *)
let processBank(pkP: pkey) =
  ! N2
  in(cB1, ());
  new n: nonce;
  out(cB1, n);
  in(cB2, s: signature);
  if check(ctx(pkP, n, certS, bankId), pkP, s) then
    event bank_accepts(pkP, n, certS).

(* -- System ------------------------------------------------------------------ *)
process
  in(cKey, ());
  new ks: keyseed;
  let skP = skgen(ks) in
  let pkP = pkgen(ks) in
  out(cKey, pkP);          (* X = pk public *)
  ( processPSU(skP, pkP) | processBank(pkP) )

(* Reading the result: CryptoVerif prints "RESULT ... is true" + a probability bound
   parameterised by Psign (UF-CMA advantage). That is the BOUND on the advantage of the
   authentication property - the "composition + bound" part of the verification framework. *)
