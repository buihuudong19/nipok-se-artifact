(* ============================================================================ *)
(*  nipok.pv — NIPoK (RFC 8235) + Channel-Binding (tls-server-end-point, RFC 5929) *)
(*  Vá G1: chứng minh tấn công Relay/MitM/Mafia-fraud liên-cluster bị TRIỆT TIÊU.   *)
(*  CHẠY:  proverif nipok.pv                                                        *)
(*                                                                                 *)
(*  CHỨNG MINH:                                                                     *)
(*    (1) secrecy(x)              — private scalar không lộ.                        *)
(*    (2) INJECTIVE-AGREEMENT-on-cb — Server accept với cb ⟹ ĐÚNG client đã prove   *)
(*        với CHÍNH cb đó. Vì verifier dùng cb = hash(cert THẬT của mình) còn pf  *)
(*        bind cb = hash(cert client NHẬN, do MitM quyết định) ⟹ relay làm lệch cb   *)
(*        ⟹ verify fail ⟹ không có server_accepts ⟹ correspondence giữ.            *)
(*                                                                                 *)
(*  GIỚI HẠN: FS/ROM-soundness là computational → cần CryptoVerif (ngoài symbolic). *)
(*                                                                                 *)
(*  G11 — KEY CUSTODY (wallet PA1, SEALED+off-heap+K8s-Secret):                     *)
(*    Ranh giới custody của Wallet ĐÃ được mô hình hóa ở đây: scalar `xA` khai       *)
(*    `[private]`, do principal PSU (Wallet) giữ, KHÔNG BAO GIỜ ra kênh net ⟹ kết    *)
(*    quả `not attacker(xA) is true` CHÍNH là chứng minh Key-Secrecy của custody     *)
(*    boundary, áp dụng cho MỌI backend (sim/Vault/TEE) — vì cả ba HIỆN THỰC HÓA      *)
(*    cùng ranh giới "x không qua interface".                                       *)
(*    NGOÀI PHẠM VI symbolic (Dolev-Yao GIẢ ĐỊNH host/RAM tin cậy): tấn công         *)
(*    dump-Pod/đọc-Secret-at-rest. Đó là threat host-security, được HIỆN THỰC HÓA     *)
(*    bởi SEALED (mã hoá in-mem) + off-heap + K8s-Secret(tmpfs, không etcd-plaintext)*)
(*    + zeroize — KHÔNG đổi mô hình này (chỉ làm giả định "custody tin cậy" thành sự  *)
(*    thật). [[stride-proverif-gap-backlog]]                                         *)
(* ============================================================================ *)

free net: channel.

type scalar.
type point.
type cb_t.                                   (* channel-binding = SHA-256(DER server cert) *)

fun pk(scalar): point.                       (* X = x·B *)
fun nizk(scalar, bitstring): bitstring.      (* pf π=(V,s) ràng buộc context *)
reduc forall x: scalar, ctx: bitstring;
      verify(pk(x), nizk(x, ctx), ctx) = true.

free verifierId: bitstring.
free certS: cb_t.                            (* hash cert THẬT gateway — Bank dùng (public) *)
free certM: cb_t.                            (* hash cert MitM/attacker (public, ≠ certS) *)
free xA: scalar [private].                   (* private scalar của PSU *)

event client_authenticates(point, bitstring, cb_t).   (* (X, nonce, cb mà CLIENT thấy) *)
event server_accepts(point, bitstring, cb_t).          (* (X, nonce, cb mà SERVER kỳ vọng) *)

(* (1) Bí mật khóa riêng *)
query attacker(xA).

(* (2) Injective-agreement TRÊN cb: server accept(X,n,cb) ⟹ client đã prove(X,n,cb) cùng cb.   *)
(*     MitM relay ⟹ cb_client(certM) ≠ cb_server(certS) ⟹ correspondence KHÔNG thể thỏa qua relay. *)
(* Ràng X = pk(xA) (Alice): Bank accept proof CỦA ALICE ⟹ ĐÚNG Alice đã prove cùng cb.
   (X tự do sẽ false vì attacker có thể tự đăng ký KHÓA RIÊNG của nó — hợp lệ, không phải lỗ hổng.) *)
query n: bitstring, cb: cb_t;
      inj-event(server_accepts(pk(xA), n, cb)) ==> inj-event(client_authenticates(pk(xA), n, cb)).

(* PSU: cb = hash(cert SERVER mà PSU THỰC SỰ kết nối) — KHÔNG để attacker tự gửi cb (đó là kịch bản
   insecure-tls). realCb cố định theo phiên: certS (nối thẳng Bank) HOẶC certM (bị MitM dẫn tới attacker).
   Attacker KHÔNG thể trình certS cho PSU (thiếu private key gateway) ⟹ proof relay luôn bind certM. *)
let PSU(x: scalar, realCb: cb_t) =
  in(net, n: bitstring);
  let ctx = (pk(x), n, realCb, verifierId) in
  event client_authenticates(pk(x), n, realCb);
  out(net, (pk(x), nizk(x, ctx))).

(* Bank: phát nonce TƯƠI; verify với cb = certS (cert THẬT của chính mình, KHÔNG lấy từ client) *)
let Bank() =
  new n: bitstring;
  out(net, n);
  in(net, (X: point, pf: bitstring));
  let ctx = (X, n, certS, verifierId) in
  if verify(X, pf, ctx) = true then
    event server_accepts(X, n, certS).

process
  out(net, pk(xA));        (* X public *)
  out(net, certS);  out(net, certM);   (* attacker biết cả 2 cert-hash; KHÔNG có key gateway *)
  ( (! PSU(xA, certS)) | (! PSU(xA, certM)) | (! Bank()) )
  (* PSU(certS) = phiên nối THẲNG Bank (honest);  PSU(certM) = phiên bị MitM (cb=cert attacker). *)

(* ──────────────────────────────────────────────────────────────────────────── *)
(*  ĐỐI CHỨNG (phiên bản LỖI — bỏ comment để thấy ProVerif tìm ra relay):          *)
(*    Nếu PSU dùng  ctx = (pk(x), n, verifierId)  [KHÔNG có cb] và Bank verify cùng  *)
(*    ctx không cb, thì query injective-on-cb KHÔNG áp được (không có cb), và một    *)
(*    query trên KÊNH sẽ FAIL: attacker relay pf (hợp lệ, unforgeable) từ phiên   *)
(*    client sang phiên của nó ⟹ server_accepts mà client không hề prove cho kênh đó.*)
(* ──────────────────────────────────────────────────────────────────────────── *)
