(* ============================================================================ *)
(*  custody-boundary.pv - formalisation of the TRUST BOUNDARY of the software custody *)
(*  (scheme 1: sealedX = AES-GCM(x) on the HEAP; KEK OFF-HEAP).                       *)
(*  Goal: ProVerif shows EXACTLY that custody secrecy depends on the assumption        *)
(*  "the KEK does not leak into a region the attacker can read" - it does NOT prove    *)
(*  'hardware security'; it only delimits assumptions I1+I2.                          *)
(* ============================================================================ *)
free x: bitstring [private].      (* private scalar (witness) - the asset to protect *)
free heap: channel.               (* ON-HEAP: READABLE by the attacker (heap snapshot) *)

(* Idealised AEAD (decryption ONLY with the right KEK) *)
fun senc(bitstring, bitstring): bitstring.
reduc forall m:bitstring, k:bitstring; sdec(senc(m,k), k) = m.

query attacker(x).

(* SEALED: ciphertext on the heap (seen by the attacker); KEK OFF-HEAP (NOT on a public channel). *)
process
  new kek: bitstring;
  out(heap, senc(x, kek))         (* the attacker has senc(x,kek) but NOT kek *)
